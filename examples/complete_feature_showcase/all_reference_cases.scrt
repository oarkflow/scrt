@schema:User
@field ID uint64 serial pk readonly
@field Name string minlength:2 maxlength:80
@field Email string format:email
@field MiddleName ?string
@field Status string enum:"Active|Inactive|Blocked" default:"Active"
@field CreatedAt timestamp default:now() readonly
@field UpdatedAt timestamp default:now()
@unique(Name, Email)
@index:idx_user_status_created(Status, CreatedAt)

@schema:Product
@field SKU string pk readonly
@field Name string minlength:2 maxlength:120
@field Price float64 min:0
@field Metadata map[string]string
@field Tags []string
@field CreatedAt timestamp default:now() readonly
@index:idx_product_price_name(Price, Name)

@schema:Address
@field Street string
@field City string
@field PostalCode string
@field Country string

@schema:Order
@field OrderID uint64 serial pk readonly
@field CustomerID ref:User:ID onDelete:cascade onUpdate:restrict
@field CreatedAt timestamp default:now() readonly
@field UpdatedAt timestamp default:now()
@field Notes ?string
@field ShippingAddress object:Address
@field Attributes map[string]string
@field Labels []string
@index:idx_order_customer_created(CustomerID, CreatedAt)

@schema:OrderItem
@field ItemID uint64 serial pk readonly
@field OrderID ref:Order:OrderID onDelete:cascade onUpdate:restrict
@field ProductSKU ref:Product:SKU onDelete:restrict onUpdate:cascade
@field Quantity int min:1 max:1000
@field UnitPrice float64 min:0
@field Subtotal float64 min:0
@field CreatedAt timestamp default:now() readonly
@field UpdatedAt timestamp default:now()
@index:idx_orderitem_order_product(OrderID, ProductSKU)
@unique(OrderID, ProductSKU)

@User
1, "Alice", "alice@example.com", null, "Active", 2026-03-04 09:00:00, 2026-03-04 09:00:00
