@schema:Message
@field MsgID uint64 serial
@field User ref:User:ID
@field Text string
@field Lang string

@schema:User
@field ID uint64 serial
@field Name string
@field Email string

@Message
1001, "Hello World!", "en"
1002, "Shipping docs ready for review", "en"

@User
1001, "John Doe", "john.doe@example.com"
1002, "Jane Smith", "jane.smith@example.com"

@schema:Incident
@field IncidentID uint64 serial
@field Title string
@field Started datetime
@field Alerted timestamptz
@field Resolved timestamp
@field ReportDate date
@field SLA duration

@Incident
